# Povinné pro AI hodnocení (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Volitelné: výchozí model (opus = přesnější, haiku = asi 40× levnější) a měsíční limit v USD; obojí jde změnit v Nastavení
AI_MODEL=haiku
AI_BUDGET_USD=5
# Volitelné: heslo do aplikace (uživatel libovolný, heslo toto). Doporučeno na Vercelu.
APP_PASSWORD=
# Volitelné: token Hlídače státu (podlimitní zakázky z profilů zadavatelů) – https://www.hlidacstatu.cz/api
HLIDAC_TOKEN=
# Volitelné: databáze (Vercel → Storage → Upstash Redis nastaví KV_REST_API_URL/TOKEN automaticky)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Ranní e-mail: Vercel Cron + Resend (https://resend.com, zdarma)
CRON_SECRET=
RESEND_API_KEY=
ALERT_EMAIL=
# ALERT_FROM="Zakázky radar <radar@tvoje-domena.cz>"  (jen s ověřenou doménou v Resend)
WATCH_MIN_SCORE=75
